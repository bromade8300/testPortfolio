@model testPortfolio.Models.Product

<div class="container-fluid">
    <div class="row">
        <!-- Navbar verticale -->
        <div class="col-auto p-0">
            <partial name="_VerticalNav" />
        </div>

        <!-- Contenu principal -->
        <div class="col">
            <div class="mt-4">
                <h2 class="text-center bg-primary text-white py-3 mb-4">Modifier le produit</h2>

                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <form asp-action="Update" asp-controller="Product" method="post" enctype="multipart/form-data"
                              aria-label="Formulaire de modification de produit">
                            <input type="hidden" asp-for="Id" />
                            @Html.AntiForgeryToken()

                            <!-- Informations de base -->
                            <fieldset>
                                <legend class="h5 text-dark">Informations de base</legend>

                                <div class="mb-3">
                                    <label asp-for="name" class="form-label">Nom du produit <span class="text-danger" aria-hidden="true">*</span></label>
                                    <input asp-for="name" class="form-control"
                                           aria-required="true"
                                           aria-describedby="edit-name-validation"
                                           required />
                                    <span asp-validation-for="name" class="text-danger" id="edit-name-validation"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="description" class="form-label">Description <span class="text-danger" aria-hidden="true">*</span></label>
                                    <textarea asp-for="description" class="form-control" rows="3"
                                              aria-required="true"
                                              aria-describedby="edit-desc-validation"
                                              required></textarea>
                                    <span asp-validation-for="description" class="text-danger" id="edit-desc-validation"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="price" class="form-label">Prix (€) <span class="text-danger" aria-hidden="true">*</span></label>
                                    <div class="input-group">
                                        <input asp-for="price" class="form-control"
                                               aria-required="true"
                                               aria-describedby="edit-price-validation"
                                               required />
                                        <span class="input-group-text" aria-hidden="true">€</span>
                                    </div>
                                    <span asp-validation-for="price" class="text-danger" id="edit-price-validation"></span>
                                </div>
                            </fieldset>

                            <!-- Images existantes -->
                            <fieldset>
                                <legend class="h5 text-dark mb-2">Images actuelles</legend>
                                <div class="mb-3">
                                    <div class="row g-2" role="list" aria-label="Liste des images du produit">
                                        @if (Model.images != null && Model.images.Any())
                                        {
                                            var index = 0;
                                            @foreach (var image in Model.images)
                                            {
                                                <div class="col-auto position-relative" data-image-index="@index" role="listitem">
                                                    <img src="@image.path"
                                                         class="img-thumbnail"
                                                         style="height: 100px; width: 100px; object-fit: cover;"
                                                         alt="Image @(index + 1) du produit @Model.name"
                                                         loading="lazy" />
                                                    <button type="button"
                                                            class="btn-close position-absolute top-0 end-0 bg-danger rounded-circle p-2"
                                                            onclick="deleteImage(@Model.Id, @index)"
                                                            aria-label="Supprimer l'image @(index + 1)"
                                                            style="transform: translate(25%, -25%);">
                                                    </button>
                                                </div>
                                                index++;
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-muted">Aucune image pour ce produit.</p>
                                        }
                                    </div>
                                </div>
                            </fieldset>

                            <!-- Ajouter de nouvelles images -->
                            <fieldset>
                                <legend class="h5 text-dark mb-2">Ajouter des images</legend>
                                <div class="mb-4">
                                    <label for="new-images" class="form-label">Sélectionnez des images</label>
                                    <input type="file"
                                           id="new-images"
                                           class="form-control"
                                           name="images"
                                           multiple
                                           accept="image/jpeg,image/png,image/gif,image/webp"
                                           aria-describedby="new-images-help" />
                                    <div id="new-images-help" class="form-text">Formats acceptés : JPEG, PNG, GIF, WebP. Taille max : 10 Mo par fichier.</div>
                                    <div id="selectedFiles" class="mt-2" role="status" aria-live="polite">
                                        <!-- Les fichiers sélectionnés seront affichés ici -->
                                    </div>
                                </div>
                            </fieldset>

                            <!-- Options de publication -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check form-switch">
                                    <input asp-for="isPublic" class="form-check-input" />
                                    <label asp-for="isPublic" class="form-check-label">Rendre public</label>
                                </div>
                            </div>

                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Index" class="btn btn-outline-secondary" id="cancelBtn">Annuler</a>
                                <button type="submit" class="btn btn-primary" id="submitBtn">
                                    <span class="btn-text">Enregistrer</span>
                                    <span class="btn-loading d-none">
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        Enregistrement...
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Affichage des fichiers sélectionnés
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            const selectedFiles = document.getElementById('selectedFiles');
            selectedFiles.innerHTML = '';

            const files = Array.from(e.target.files);
            files.forEach(file => {
                const fileDiv = document.createElement('div');
                fileDiv.className = 'alert alert-info mb-1 d-flex justify-content-between align-items-center';
                const span = document.createElement('span');
                span.textContent = file.name;
                fileDiv.appendChild(span);
                selectedFiles.appendChild(fileDiv);
            });
        });

        // État de chargement lors de la soumission
        document.querySelector('form').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            const cancelBtn = document.getElementById('cancelBtn');
            const btnText = submitBtn.querySelector('.btn-text');
            const btnLoading = submitBtn.querySelector('.btn-loading');

            if (this.checkValidity()) {
                submitBtn.disabled = true;
                cancelBtn.classList.add('disabled');
                btnText.classList.add('d-none');
                btnLoading.classList.remove('d-none');
            }
        });

        // Suppression d'image
        function deleteImage(productId, pictureIndex) {
            if (confirm('Êtes-vous sûr de vouloir supprimer cette image ?')) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const btn = event.target.closest('button');

                // Désactiver le bouton pendant la suppression
                if (btn) btn.disabled = true;

                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);
                formData.append('productId', productId);
                formData.append('PictureIndex', pictureIndex);

                fetch('/Product/DeleteImage', {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    if (response.ok) {
                        const imageElement = document.querySelector(`[data-image-index="${pictureIndex}"]`);
                        if (imageElement) {
                            imageElement.style.transition = 'opacity 0.3s';
                            imageElement.style.opacity = '0';
                            setTimeout(() => imageElement.remove(), 300);
                        } else {
                            window.location.reload();
                        }
                    } else {
                        alert('Une erreur est survenue lors de la suppression de l\'image');
                        if (btn) btn.disabled = false;
                    }
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    alert('Une erreur est survenue lors de la suppression de l\'image');
                    if (btn) btn.disabled = false;
                });
            }
        }
    </script>
}
