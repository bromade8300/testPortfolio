@model testPortfolio.Models.Product

<div class="container-fluid">
    <div class="row">
        <!-- Navbar verticale -->
        <div class="col-auto p-0">
            <partial name="_VerticalNav" />
        </div>

        <!-- Contenu principal -->
        <div class="col">
            <div class="mt-4">
                <h2 class="text-center bg-primary text-white py-3 mb-4">Modifier le produit</h2>

                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <form asp-action="Update" asp-controller="Product" method="post" enctype="multipart/form-data">
                            <input type="hidden" asp-for="Id" />
                            @Html.AntiForgeryToken()
                            
                            <!-- Informations de base -->
                            <h5 class="text-dark">Informations de base</h5>
                            
                            <div class="mb-3">
                                <label asp-for="name" class="form-label">Nom du produit</label>
                                <input asp-for="name" class="form-control" required />
                            </div>

                            <div class="mb-3">
                                <label asp-for="description" class="form-label">Description</label>
                                <textarea asp-for="description" class="form-control" rows="3" required></textarea>
                            </div>

                            <div class="mb-4">
                                <label asp-for="price" class="form-label">Prix (€)</label>
                                <div class="input-group">
                                    <input asp-for="price" class="form-control" required />
                                    <span class="input-group-text">€</span>
                                </div>
                            </div>

                            <!-- Images existantes -->
                            <h5 class="text-dark mb-2">Images actuelles</h5>
                            <div class="mb-3">
                                <div class="row g-2">
                                    @if (Model.images != null && Model.images.Any())
                                    {
                                        var index = 0;
                                        @foreach (var image in Model.images)
                                        {
                                            <div class="col-auto position-relative" data-image-index="@index">
                                                <img src="@image.path" class="img-thumbnail" style="height: 100px; width: 100px; object-fit: cover;" />
                                                <button type="button"
                                                        class="btn-close position-absolute top-0 end-0 bg-danger rounded-circle p-2"
                                                        onclick="deleteImage(@Model.Id, @index)"
                                                        style="transform: translate(25%, -25%);">
                                                </button>
                                            </div>
                                            index++;
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Ajouter de nouvelles images -->
                            <h5 class="text-dark mb-2">Ajouter des images</h5>
                            <div class="mb-4">
                                <label class="form-label">Sélectionnez des images</label>
                                <input type="file" 
                                       class="form-control" 
                                       name="images" 
                                       multiple 
                                       accept="image/*" />
                                <div id="selectedFiles" class="mt-2">
                                    <!-- Les fichiers sélectionnés seront affichés ici -->
                                </div>
                            </div>

                            <!-- Options de publication -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check form-switch">
                                    <input asp-for="isPublic" class="form-check-input" />
                                    <label asp-for="isPublic" class="form-check-label">Rendre public</label>
                                </div>
                            </div>

                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                                <button type="submit" class="btn btn-primary">Enregistrer</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            const selectedFiles = document.getElementById('selectedFiles');
            selectedFiles.innerHTML = '';

            const files = Array.from(e.target.files);
            files.forEach(file => {
                const fileDiv = document.createElement('div');
                fileDiv.className = 'alert alert-info mb-1 d-flex justify-content-between align-items-center';
                const span = document.createElement('span');
                span.textContent = file.name; // Protection XSS: utiliser textContent au lieu de innerHTML
                fileDiv.appendChild(span);
                selectedFiles.appendChild(fileDiv);
            });
        });

        function deleteImage(productId, pictureIndex) {
            if (confirm('Êtes-vous sûr de vouloir supprimer cette image ?')) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                // Envoyer le token via FormData pour la validation CSRF
                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);
                formData.append('productId', productId);
                formData.append('PictureIndex', pictureIndex);

                fetch('/Product/DeleteImage', {
                    method: 'POST',
                    body: formData
                })
                .then(response => {
                    if (response.ok) {
                        const imageElement = document.querySelector(`[data-image-index="${pictureIndex}"]`);
                        if (imageElement) {
                            imageElement.remove();
                        } else {
                            window.location.reload();
                        }
                    } else {
                        alert('Une erreur est survenue lors de la suppression de l\'image');
                    }
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    alert('Une erreur est survenue lors de la suppression de l\'image');
                });
            }
        }
    </script>
}
