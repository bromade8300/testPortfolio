@model testPortfolio.Models.Product

<div class="container-fluid">
    <div class="row">
        <!-- Navbar verticale -->
        <div class="col-auto p-0">
            <partial name="_VerticalNav" />
        </div>

        <!-- Contenu principal -->
        <div class="col">
            <div class="mt-4">
                <h2 class="text-center bg-primary text-white py-3 mb-4">Nouveau produit</h2>

                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <form asp-action="Create" asp-controller="Product" method="post" enctype="multipart/form-data"
                              aria-label="Formulaire de création de produit">
                            @Html.AntiForgeryToken()

                            <!-- Informations de base -->
                            <fieldset>
                                <legend class="h5 text-dark">Informations de base</legend>

                                <div class="mb-3">
                                    <label asp-for="name" class="form-label" id="name-label">Nom du produit <span class="text-danger" aria-hidden="true">*</span></label>
                                    <input asp-for="name" class="form-control"
                                           aria-required="true"
                                           aria-describedby="name-help name-validation"
                                           required />
                                    <div id="name-help" class="form-text">Entrez un nom descriptif pour le produit</div>
                                    <span asp-validation-for="name" class="text-danger" id="name-validation"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="description" class="form-label" id="desc-label">Description <span class="text-danger" aria-hidden="true">*</span></label>
                                    <textarea asp-for="description" class="form-control" rows="3"
                                              aria-required="true"
                                              aria-describedby="desc-help desc-validation"
                                              required></textarea>
                                    <div id="desc-help" class="form-text">Décrivez les caractéristiques principales du produit</div>
                                    <span asp-validation-for="description" class="text-danger" id="desc-validation"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="price" class="form-label" id="price-label">Prix (€) <span class="text-danger" aria-hidden="true">*</span></label>
                                    <div class="input-group">
                                        <input asp-for="price" class="form-control"
                                               aria-required="true"
                                               aria-describedby="price-validation"
                                               required />
                                        <span class="input-group-text" aria-hidden="true">€</span>
                                    </div>
                                    <span asp-validation-for="price" class="text-danger" id="price-validation"></span>
                                </div>
                            </fieldset>

                            <!-- Images -->
                            <fieldset>
                                <legend class="h5 text-dark mb-2">Images</legend>
                                <div class="mb-4">
                                    <label for="images" class="form-label">Sélectionnez des images <span class="text-danger" aria-hidden="true">*</span></label>
                                    <input type="file"
                                           id="images"
                                           class="form-control"
                                           name="images"
                                           multiple
                                           accept="image/jpeg,image/png,image/gif,image/webp"
                                           aria-required="true"
                                           aria-describedby="images-help"
                                           required />
                                    <div id="images-help" class="form-text">Formats acceptés : JPEG, PNG, GIF, WebP. Taille max : 10 Mo par fichier.</div>
                                    <div id="selectedFiles" class="mt-2" role="status" aria-live="polite">
                                        <!-- Les fichiers sélectionnés seront affichés ici -->
                                    </div>
                                </div>
                            </fieldset>

                            <!-- Options de publication -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check form-switch">
                                    <input asp-for="isPublic" class="form-check-input" />
                                    <label asp-for="isPublic" class="form-check-label">Rendre public</label>
                                </div>
                            </div>

                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-action="Index" class="btn btn-outline-secondary" id="cancelBtn">Annuler</a>
                                <button type="submit" class="btn btn-primary" id="submitBtn">
                                    <span class="btn-text">Créer</span>
                                    <span class="btn-loading d-none">
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        Création en cours...
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Affichage des fichiers sélectionnés
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            const selectedFiles = document.getElementById('selectedFiles');
            selectedFiles.innerHTML = '';

            const files = Array.from(e.target.files);
            files.forEach(file => {
                const fileDiv = document.createElement('div');
                fileDiv.className = 'alert alert-info mb-1 d-flex justify-content-between align-items-center';
                const span = document.createElement('span');
                span.textContent = file.name;
                fileDiv.appendChild(span);
                selectedFiles.appendChild(fileDiv);
            });
        });

        // État de chargement lors de la soumission
        document.querySelector('form').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('submitBtn');
            const cancelBtn = document.getElementById('cancelBtn');
            const btnText = submitBtn.querySelector('.btn-text');
            const btnLoading = submitBtn.querySelector('.btn-loading');

            // Vérifier si le formulaire est valide
            if (this.checkValidity()) {
                submitBtn.disabled = true;
                cancelBtn.classList.add('disabled');
                btnText.classList.add('d-none');
                btnLoading.classList.remove('d-none');
            }
        });
    </script>
}
