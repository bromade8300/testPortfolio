@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 5rem;" aria-hidden="true"></i>
            </div>

            <h1 class="display-4 text-danger mb-3">Une erreur s'est produite</h1>
            <p class="lead text-muted mb-4">
                Nous sommes désolés, quelque chose s'est mal passé lors du traitement de votre demande.
            </p>

            @if (Model?.ShowRequestId ?? false)
            {
                <div class="alert alert-secondary" role="alert">
                    <small>
                        <strong>ID de la requête :</strong> <code>@Model.RequestId</code>
                        <br />
                        <span class="text-muted">Conservez cet identifiant si vous contactez le support.</span>
                    </small>
                </div>
            }

            <div class="d-flex gap-3 justify-content-center mt-4">
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house me-2" aria-hidden="true"></i>Retour à l'accueil
                </a>
                <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
                    <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Page précédente
                </button>
            </div>
        </div>
    </div>
</div>
