@{
    ViewData["Title"] = "Page introuvable";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="mb-4">
                <span class="display-1 text-primary fw-bold">404</span>
            </div>

            <h1 class="display-5 mb-3">Page introuvable</h1>
            <p class="lead text-muted mb-4">
                La page que vous recherchez n'existe pas ou a été déplacée.
            </p>

            <div class="card bg-light border-0 mb-4">
                <div class="card-body">
                    <p class="mb-2"><strong>Que s'est-il passé ?</strong></p>
                    <ul class="list-unstyled text-muted mb-0">
                        <li><i class="bi bi-dot" aria-hidden="true"></i> L'adresse URL a peut-être été mal saisie</li>
                        <li><i class="bi bi-dot" aria-hidden="true"></i> La page a peut-être été supprimée ou déplacée</li>
                        <li><i class="bi bi-dot" aria-hidden="true"></i> Le lien que vous avez suivi est peut-être obsolète</li>
                    </ul>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-center">
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house me-2" aria-hidden="true"></i>Retour à l'accueil
                </a>
                <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
                    <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Page précédente
                </button>
            </div>
        </div>
    </div>
</div>
