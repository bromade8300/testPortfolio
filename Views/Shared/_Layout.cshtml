<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - testPortfolio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/_variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/testPortfolio.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
        rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Skip link pour l'accessibilité clavier -->
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow"
             role="navigation"
             aria-label="Navigation principale">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">testPortfolio</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                    var isHomeIndex = currentController == "Home" && currentAction == "Index";
                    var isPrivacy = currentController == "Home" && currentAction == "Privacy";
                    var isServices = currentController == "Home" && currentAction == "Services";
                    var isBackOffice = currentController == "BackOffice";
                }
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @(isHomeIndex ? "active fw-semibold" : "text-dark")"
                               asp-area="" asp-controller="Home" asp-action="Index">
                                Accueil
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isPrivacy ? "active fw-semibold" : "text-dark")"
                               asp-area="" asp-controller="Home" asp-action="Privacy">
                                Confidentialité
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isServices ? "active fw-semibold" : "text-dark")"
                               asp-area="" asp-controller="Home" asp-action="Services">
                                Services
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index">
                                    Mon Compte
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Logout">
                                    Se déconnecter
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(isBackOffice ? "active fw-semibold" : "text-dark")"
                                   asp-area="" asp-action="Index" asp-controller="BackOffice">
                                    <i class="bi bi-gear me-1" aria-hidden="true"></i>Administration
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>






    </header>

    <!-- Toast messages for feedback -->
    <partial name="_ToastMessages" />

    <main id="main-content" role="main" class="pb-3" tabindex="-1">
        @RenderBody()
    </main>
    @* </div> *@

    @* <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - testPortfolio - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
